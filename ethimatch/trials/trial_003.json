{
  "trial_id": "NCT-FAKE-003",
  "trial_name": "Phase II SCLC First-Line Chemo-Immunotherapy",
  "description": "A study of carboplatin, etoposide, and durvalumab in treatment-naive extensive-stage small cell lung cancer.",
  "inclusion": {
    "age_min": 18,
    "age_max": 75,
    "gender": ["male", "female"],
    "diseases": ["SCLC"],
    "stages": ["III", "IIIA", "IIIB", "IV"],
    "required_biomarkers": [],
    "ecog_max": 2,
    "bmi_max": 35.0
  },
  "exclusion": {
    "excluded_comorbidities": [
      "CHF",
      "COPD"
    ],
    "excluded_prior_therapies": [
      "pembrolizumab",
      "nivolumab"
    ],
    "bmi_min": 16.0
  }
}
